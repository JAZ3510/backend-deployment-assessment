aws_region            = "us-east-1"
bastion_instance_type = "t3.micro"
backend_instance_type = "t3.micro"
mongodb_instance_type = "t3.micro"

# Your current public IP in CIDR form: curl -s https://checkip.amazonaws.com
my_ip = "203.0.113.10/32"

# Name of an EXISTING EC2 key pair in the chosen region
key_name = "your-key-pair-name"
